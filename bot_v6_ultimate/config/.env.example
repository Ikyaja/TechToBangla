# AI Future Signal Bot V6 Ultimate - Configuration

# Telegram Bot Token (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Binance API Keys (Optional - bot works in demo mode without these)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Bot Settings
BOT_NAME=AI FUTURE SIGNAL V6 ULTIMATE
DEFAULT_LEVERAGE=125
MAX_RISK_PERCENT=2.0
WIN_RATE_HISTORY=0.85

# Note: Copy this file to .env and fill in your credentials
# cp config/.env.example config/.env
# nano config/.env
